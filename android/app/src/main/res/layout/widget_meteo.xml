<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « ciel vivant », comme l'appli : fond aux couleurs du ciel, cartes en verre, grande température.
     Toutes les tailles sauf la plus petite utilisent cette mise en page : le widget mesure ce qui tient
     dans la place disponible et masque les blocs les moins importants (MeteoWidget.fit), sans jamais couper. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fond séparé : ciel du moment, ou couleur et transparence réglées dans l'appli. -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- Grande horloge et date (réglable). -->
        <LinearLayout
            android:id="@+id/clock_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextClock
                android:id="@+id/clock"
                style="@style/WText"
                android:fontFamily="sans-serif-thin"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textSize="44sp" />
            <TextClock
                android:id="@+id/date"
                style="@style/WMuted"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:paddingBottom="5dp"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- En-tête : lieu, heure de mise à jour, actualiser (comme la barre du haut de l'appli). -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/place" style="@style/WBold" android:layout_width="0dp" android:layout_weight="1" android:textSize="15sp" android:text="Météo fiable" />
            <TextClock android:id="@+id/clock_small" style="@style/WBold" android:layout_marginStart="8dp" android:textSize="15sp" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:visibility="gone" />
            <TextView android:id="@+id/updated" style="@style/WMuted" android:layout_marginStart="8dp" android:textSize="11sp" android:text="" />
            <TextView android:id="@+id/refresh" style="@style/WText" android:paddingStart="10dp" android:paddingEnd="2dp" android:textSize="16sp" android:text="⟳" />
        </LinearLayout>

        <!-- Temps actuel : icône animée, grande température fine, ciel et ressenti. -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ViewFlipper
                android:id="@+id/icon_anim"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:autoStart="true"
                android:flipInterval="160">
            <ImageView android:id="@+id/icon_f0" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_f1" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_f2" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_f3" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_f4" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_f5" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_f6" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_f7" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" />
            </ViewFlipper>
            <TextView
                android:id="@+id/temp"
                style="@style/WText"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:textSize="52sp"
                android:text="--°" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">
                <TextView android:id="@+id/cond" style="@style/WBold" android:textSize="15sp" android:text="Chargement…" />
                <TextView android:id="@+id/feels" style="@style/WMuted" android:text="" />
                <TextView android:id="@+id/minmax" style="@style/WMuted" android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vent, affiché ici seulement quand les cases ne tiennent pas. -->
        <TextView android:id="@+id/wind" style="@style/WBold" android:layout_width="match_parent" android:layout_marginTop="2dp" android:text="" />

        <!-- Alerte la plus importante, teintée selon le niveau. -->
        <TextView
            android:id="@+id/alert"
            style="@style/WBold"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:background="@drawable/alert_bg_3"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:text="" />

        <!-- Cases comme dans l'appli : vent, pluie, mer, fiabilité. -->
        <LinearLayout
            android:id="@+id/tiles"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/tile_wind" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/glass_bg" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="7dp">
                <TextView android:id="@+id/tile_wind_label" style="@style/WLabel" android:text="Vent" />
                <TextView android:id="@+id/tile_wind_value" style="@style/WValue" android:text="" />
                <TextView android:id="@+id/tile_wind_sub" style="@style/WMuted" android:textSize="11sp" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_rain" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/glass_bg" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="7dp">
                <TextView android:id="@+id/tile_rain_label" style="@style/WLabel" android:text="Pluie" />
                <TextView android:id="@+id/tile_rain_value" style="@style/WValue" android:text="" />
                <TextView android:id="@+id/tile_rain_sub" style="@style/WMuted" android:textSize="11sp" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_sea" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/glass_bg" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="7dp">
                <TextView android:id="@+id/tile_sea_label" style="@style/WLabel" android:text="Mer" />
                <TextView android:id="@+id/tile_sea_value" style="@style/WValue" android:text="" />
                <TextView android:id="@+id/tile_sea_sub" style="@style/WMuted" android:textSize="11sp" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_conf" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/glass_bg" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="7dp">
                <TextView android:id="@+id/tile_conf_label" style="@style/WLabel" android:text="Fiabilité" />
                <TextView android:id="@+id/tile_conf_value" style="@style/WValue" android:text="" />
                <TextView android:id="@+id/tile_conf_sub" style="@style/WMuted" android:textSize="11sp" android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Première ligne de prévision : par jour ou par heure selon le réglage. -->
        <LinearLayout
            android:id="@+id/strip_a"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/glass_bg"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="7dp">
            <LinearLayout android:id="@+id/a0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/a0_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/a0_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/a0_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/a0_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/a0_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/a0_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/a1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/a1_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/a1_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/a1_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/a1_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/a1_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/a1_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/a2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/a2_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/a2_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/a2_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/a2_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/a2_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/a2_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/a3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/a3_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/a3_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/a3_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/a3_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/a3_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/a3_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/a4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/a4_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/a4_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/a4_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/a4_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/a4_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/a4_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/a5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/a5_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/a5_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/a5_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/a5_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/a5_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/a5_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Seconde ligne : l'autre prévision, quand il reste de la place. -->
        <LinearLayout
            android:id="@+id/strip_b"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/glass_bg"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="7dp">
            <LinearLayout android:id="@+id/b0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/b0_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/b0_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/b0_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/b0_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/b0_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/b0_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/b1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/b1_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/b1_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/b1_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/b1_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/b1_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/b1_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/b2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/b2_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/b2_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/b2_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/b2_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/b2_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/b2_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/b3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/b3_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/b3_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/b3_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/b3_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/b3_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/b3_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/b4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/b4_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/b4_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/b4_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/b4_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/b4_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/b4_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
            <LinearLayout android:id="@+id/b5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/b5_t" style="@style/WColT" android:text="" />
                <ImageView android:id="@+id/b5_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="2dp" android:contentDescription="@null" />
                <TextView android:id="@+id/b5_temp" style="@style/WColTemp" android:text="" />
                <TextView android:id="@+id/b5_min" style="@style/WColMin" android:text="" android:visibility="gone" />
                <TextView android:id="@+id/b5_pop" style="@style/WPop" android:text="" />
                <TextView android:id="@+id/b5_wind" style="@style/WWind" android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lever et coucher du soleil et de la lune. -->
        <TextView android:id="@+id/sky" style="@style/WMuted" android:visibility="gone" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="" />

        <!-- Bons créneaux de sortie. -->
        <TextView android:id="@+id/sessions" style="@style/WMuted" android:visibility="gone" android:layout_width="match_parent" android:layout_marginTop="4dp" android:maxLines="2" android:text="" />
    </LinearLayout>
</FrameLayout>
